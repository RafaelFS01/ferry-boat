# Ambiente: development, test ou production.
NODE_ENV=development

# API interna do barco (Painel do Capitão e healthcheck do Docker Compose).
API_HOST=0.0.0.0
API_PORT=3002

# Identificador da embarcação e ciclo de coleta/envio em milissegundos (5s).
BOAT_ID=ferry-ivete-sangalo
TELEMETRY_INTERVAL_MS=5000

# SCRUM-13: simulador sintetico; o buffer da SCRUM-15 conecta coleta e envio.
SIMULATOR_ENABLED=true
SIMULATOR_DOCK_TIME_MS=30000
SIMULATOR_FUEL_CAPACITY_L=2000
# Seed opcional de 0 a 4294967295; reproduz sensores, nao UUIDs.
# SIMULATOR_SEED=13

# Endereço host:porta da Central. No Docker Compose: ferry-central:50051.
CENTRAL_GRPC_URL=localhost:50051
# Deadline por tentativa (1 a 2500ms); o teto protege o loop de envio.
GRPC_DEADLINE_MS=2500
# Total de tentativas (1 a 10), incluindo a original. 1 desabilita retries.
# Padrão: cinco retries com bases 2/4/8/16/30s e jitter de ±20%, teto de 30s.
GRPC_RETRY_MAX_ATTEMPTS=6

# SCRUM-15: janela FIFO em RAM; todos os pacotes sao persistidos em SQLite.
BUFFER_ENABLED=true
# Limita apenas o cache em memoria (1 a 100000), nao o total retido em disco.
BUFFER_MAX_ITEMS=5000
BUFFER_BACKUP_PATH=./data/telemetry-buffer.sqlite
# Pausa minima apos cada ACK; 20ms permite no maximo 50 envios/s.
BUFFER_DRAIN_INTERVAL_MS=20
# Espera apos esgotar retries transitorios do cliente gRPC.
BUFFER_RETRY_INTERVAL_MS=5000

# Opcional: caminho absoluto ou relativo à raiz de ferry-boat para o IDL.
# Sem override, procura ../proto/telemetry.proto ou /proto/telemetry.proto.
# O build também inclui o contrato em dist/proto/telemetry.proto.
# TELEMETRY_PROTO_PATH=../proto/telemetry.proto
# Opcional: executável protoc nativo. O Dockerfile Alpine define /usr/bin/protoc.
# PROTOC_PATH=/usr/bin/protoc

# mTLS: informe os três arquivos PEM em conjunto; obrigatório em production.
# Sem certificados, somente development/test usam o canal local sem TLS.
# GRPC_TLS_CA_PATH=./certs/ca.crt
# GRPC_TLS_CERT_PATH=./certs/boat.crt
# GRPC_TLS_KEY_PATH=./certs/boat.key
