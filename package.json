{
  "name": "ferry-boat",
  "version": "0.1.0",
  "private": true,
  "description": "Nó embarcado de telemetria marítima Salvador–Itaparica",
  "type": "commonjs",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "proto:generate": "node --env-file-if-exists=.env scripts/proto.cjs generate",
    "build": "npm run proto:generate && nest build && node --env-file-if-exists=.env scripts/proto.cjs copy",
    "start": "npm run proto:generate && nest start",
    "start:dev": "npm run proto:generate && nest start --watch",
    "start:debug": "npm run proto:generate && nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "npm run proto:generate && tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@types/node": "^24.19.0",
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.18.4",
    "typescript": "~6.0.3"
  }
}
